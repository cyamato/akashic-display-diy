# Copy to secrets.py on the Inky Frame (it stays on the device; never commit it).
WIFI_SSID = "your-wifi"
WIFI_PASSWORD = "your-password"
SERVER = "https://dash.example.com"
LABEL = "Inky Frame"
LOCATION = "Office door"
# The room's status key (pds_...) from /admin -> Rooms, for buttons A (busy), B (available)
# and C (back to the calendar). Leave empty for a display that only shows.
ROOM_KEY = ""
BUSY_MINUTES = 60
TIME_ZONE = "Pacific/Auckland"
CLOCK = 24
# Minutes between wakes on battery.
MINUTES = 10
